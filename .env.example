# MUID environment configuration template.
# Copy to `.env` and fill in real values. Never commit your `.env`.

# --- Core / server ---

# Port the HTTP server listens on (defaults to 3000)
PORT=3000

# MariaDB connection string used by Prisma (mysql://user:pass@host:3306/db)
DATABASE_URL=

# --- Secrets (each must be at least 32 characters; no placeholder values) ---

# Cookie session signing secret
SESSION_SECRET=<generate-with: openssl rand -hex 32>

# Encryption key for JWKS private keys at rest
JWKS_ENC_KEY=<generate-with: openssl rand -hex 32>

# better-auth secret used for hashing/signing
BETTER_AUTH_SECRET=<generate-with: openssl rand -hex 32>

# --- OIDC provider ---

# Public issuer URL of this IdP (required in production, e.g. https://id.example.com)
OIDC_ISSUER=

# --- Social sign-in (Google OAuth) ---

# Google OAuth client ID
AUTH_GOOGLE_CLIENT_ID=

# Google OAuth client secret
AUTH_GOOGLE_CLIENT_SECRET=

# --- Cloudflare Turnstile CAPTCHA ---

# Server-side Turnstile secret key
TURNSTILE_SECRET_KEY=

# Client-side (public) Turnstile site key, exposed to the browser by Vite
VITE_TURNSTILE_SITE_KEY=

# --- SMTP (outgoing mail) ---

# SMTP server hostname
SMTP_HOST=

# SMTP server port (e.g. 587 for STARTTLS, 465 for TLS)
SMTP_PORT=587

# Set to "true" to use an implicit-TLS connection (port 465)
SMTP_SECURE=false

# SMTP username
SMTP_USER=

# SMTP password
SMTP_PASS=

# From address used for outgoing mail (e.g. "MuID <no-reply@example.com>")
SMTP_FROM=

# --- Redis (cache, OIDC adapter, BullMQ) ---

# Redis hostname (defaults to localhost)
REDIS_HOST=localhost

# Redis port (defaults to 6379)
REDIS_PORT=6379

# Redis username (optional)
REDIS_USER=

# Redis password (optional)
REDIS_PASS=

# Redis database index (defaults to 0)
REDIS_DB=0

# Key prefix for queue/cache entries (optional)
REDIS_PREFIX=

# --- Background queue ---

# Number of concurrent BullMQ workers (defaults to 5)
QUEUE_CONCURRENCY=

# --- Google Cloud Pub/Sub ---

# Path to the Google service account JSON key file (keep the file out of git)
GOOGLE_APPLICATION_CREDENTIALS=

# --- Logging ---

# Log level: debug | info | warn | error (defaults to info)
LOG_LEVEL=info

# --- Security hardening (introduced by security hardening, optional until merged) ---

# Suffix identifying corporate OIDC clients (introduced by security hardening, optional until merged)
CORP_CLIENT_SUFFIX=

# Comma-separated email domains allowed for corporate clients (introduced by security hardening, optional until merged)
CORP_ALLOWED_EMAIL_DOMAINS=

# Suffix identifying service OIDC clients (introduced by security hardening, optional until merged)
SERVICE_CLIENT_SUFFIX=

# Default resource indicator for OIDC tokens (introduced by security hardening, optional until merged)
OIDC_DEFAULT_RESOURCE=

# Comma-separated keys used to sign oidc-provider cookies (introduced by security hardening, optional until merged)
OIDC_COOKIE_KEYS=

# Encryption key for tokens at rest (introduced by security hardening, optional until merged)
TOKEN_ENC_KEY=

# Express trust proxy setting, e.g. "1" or "loopback" (introduced by security hardening, optional until merged)
TRUST_PROXY=
